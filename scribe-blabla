# --- Classe pour gérer les infobulles intelligentes (anti-troncature) ---
class ToolTip:
    def __init__(self, widget, texte):
        self.widget = widget
        self.texte = texte
        self.tipwindow = None
        self.id = None
        self.widget.bind("<Enter>", self.entree)
        self.widget.bind("<Leave>", self.sortie)

    def entree(self, event=None):
        self.planifier_affichage()

    def sortie(self, event=None):
        self.annuler()
        self.masquer()

    def planifier_affichage(self):
        self.annuler()
        self.id = self.widget.after(500, self.afficher)

    def annuler(self):
        id_actuel = self.id
        self.id = None
        if id_actuel:
            self.widget.after_cancel(id_actuel)

    def afficher(self):
        if self.tipwindow or not self.texte:
            return
        
        self.tipwindow = tw = tk.Toplevel(self.widget)
        tw.wm_overrideredirect(True)
        
        label = tk.Label(
            tw, text=self.texte, justify=tk.LEFT,
            background="#FFFFE0", relief=tk.SOLID, borderwidth=1,
            font=(POLICE_UI, taille_police_infobulles)
        )
        label.pack(ipadx=4, ipady=2)
        tw.update_idletasks()

        x = self.widget.winfo_rootx() + 10
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 5
        
        largeur_bulle = tw.winfo_reqwidth()
        largeur_fenetre_app = root.winfo_rootx() + root.winfo_width()

        if x + largeur_bulle > largeur_fenetre_app - 10:
            x = largeur_fenetre_app - largeur_bulle - 10

        tw.wm_geometry(f"+{x}+{y}")

    def masquer(self):
        tw = self.tipwindow
        self.tipwindow = None
        if tw:
            tw.destroy()

