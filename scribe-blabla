def selectionner_fichier():
    global chemin_fichier_actuel, texte_initial
    if verifier_modifications():
        reponse = messagebox.askyesnocancel("Fichier modifié", "Le texte actuel a été modifié. Souhaitez-vous l'enregistrer ?")
        if reponse is True:
            enregistrer_texte()
        elif reponse is None:
            return

    dernier_dir = config_actuelle.get("dernier_dossier", os.path.expanduser("~"))
    chemin = filedialog.askopenfilename(
        initialdir=dernier_dir,
        title="Sélectionner un fichier texte",
        filetypes=[("Fichiers texte", "*.txt"), ("Tous les fichiers", "*.*")]
    )
    if chemin:
        chemin_fichier_actuel = chemin
        entree_chemin.delete(0, tk.END)
        entree_chemin.insert(0, chemin)
        try:
            with open(chemin, 'r', encoding='utf-8') as f:
                contenu = f.read()
            zone_texte.delete("1.0", tk.END)
            zone_texte.insert("1.0", contenu)
            texte_initial = contenu
            config_actuelle["dernier_dossier"] = os.path.dirname(chemin)
            ajouter_aux_recents(chemin)
            mettre_a_jour_indicateur_fichier()
        except Exception as e:
            messagebox.showerror("Erreur", f"Impossible de lire le fichier :\n{e}")

def verifier_modifications():
    texte_actuel = zone_texte.get("1.0", tk.END).strip()
    return texte_actuel != texte_initial.strip()

def enregistrer_texte(event=None):
    global chemin_fichier_actuel, texte_initial
    texte_actuel = zone_texte.get("1.0", tk.END).strip()
    if not chemin_fichier_actuel:
        dernier_dir = config_actuelle.get("dernier_dossier", os.path.expanduser("~"))
        chemin = filedialog.asksaveasfilename(
            initialdir=dernier_dir,
            defaultextension=".txt",
            filetypes=[("Fichiers texte", "*.txt")],
            title="Enregistrer le fichier texte sous"
        )
        if not chemin:
            return "break"
        chemin_fichier_actuel = chemin
        entree_chemin.delete(0, tk.END)
        entree_chemin.insert(0, chemin_fichier_actuel)
        
    try:
        with open(chemin_fichier_actuel, 'w', encoding='utf-8') as f:
            f.write(texte_actuel)
        texte_initial = texte_actuel
        ajouter_aux_recents(chemin_fichier_actuel)
        mettre_a_jour_indicateur_fichier()
        messagebox.showinfo("Enregistrement", "Fichier texte enregistré avec succès.")
    except Exception as e:
        messagebox.showerror("Erreur", f"Impossible d'enregistrer le fichier :\n{e}")
    return "break"

