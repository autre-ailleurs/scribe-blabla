def executer_lecture_interactive():
    global processus_lecture, lecture_en_cours, fichiers_temporaires
    try:
        selection_langue = combo_langue.get()
        dico_langues = {
            "Français (France)": {"lang": "fr", "tld": "com"},
            "Français (Canada)": {"lang": "fr", "tld": "ca"},
            "Anglais (États-Unis)": {"lang": "en", "tld": "com"},
            "Anglais (Royaume-Uni)": {"lang": "en", "tld": "co.uk"},
            "Espagnol": {"lang": "es", "tld": "com"},
            "Italien": {"lang": "it", "tld": "com"}
        }
        params = dico_langues.get(selection_langue, {"lang": "fr", "tld": "com"})

        selection_vitesse = combo_vitesse.get()
        dico_vitesses = {
            "0.5x (Très lent)": 0.5, "0.75x (Ralenti)": 0.75, "0.9x (Léger ralenti)": 0.9,
            "0.95x (Ralenti fin)": 0.95, "1.0x (Standard)": 1.0, "1.25x (Rapide)": 1.25, 
            "1.5x (Très rapide)": 1.5, "1.75x (Soutenu)": 1.75, "2.0x (Double vitesse)": 2.0
        }
        facteur_vitesse = dico_vitesses.get(selection_vitesse, 1.0)

        pos_curseur = zone_texte.index(tk.INSERT)
        texte_restant = zone_texte.get(pos_curseur, tk.END).strip()
        if not texte_restant:
            texte_restant = zone_texte.get("1.0", tk.END).strip()

        morceaux = re.split(r'(?<=[.!?\n])\s+', texte_restant)
        morceaux = [m.strip() for m in morceaux if m.strip()]

        for morceau in morceaux:
            if not lecture_en_cours:
                break

            root.after(0, lambda m=morceau: surligner_morceau(m))

            with tempfile.NamedTemporaryFile(delete=False, suffix=".mp3") as temp_file:
                temp_path = temp_file.name
                fichiers_temporaires.append(temp_path)

            generer_audio_morceau(morceau, selection_langue, params, facteur_vitesse, temp_path)

            if not lecture_en_cours:
                break

            processus_lecture = subprocess.Popen(["mpv", "--no-video", "--really-quiet", temp_path])
            processus_lecture.wait()

    except Exception as e:
        root.after(0, lambda err=str(e): messagebox.showwarning("Avertissement - Voix Locale", err))
    finally:
        arreter_lecture_directe()

def arreter_lecture_directe():
    global processus_lecture, lecture_en_cours, fichiers_temporaires
    lecture_en_cours = False
    
    if processus_lecture:
        try:
            processus_lecture.terminate()
            processus_lecture.kill()
        except:
            pass
        processus_lecture = None
        
    for f in fichiers_temporaires:
        if os.path.exists(f):
            try:
                os.remove(f)
            except:
                pass
    fichiers_temporaires = []
    
    def reinitialiser_interface():
        try:
            zone_texte.tag_remove("surligne", "1.0", tk.END)
            lbl_lecture.config(text="Lire à partir du curseur", bg="#1976D2", cursor="hand2")
        except:
            pass

    root.after(0, reinitialiser_interface)

def surligner_morceau(texte_recherche):
    try:
        idx_debut = zone_texte.search(texte_recherche, "1.0", tk.END)
        if idx_debut:
            idx_fin = f"{idx_debut}+{len(texte_recherche)}c"
            zone_texte.tag_remove("surligne", "1.0", tk.END)
            zone_texte.tag_add("surligne", idx_debut, idx_fin)
            zone_texte.tag_config("surligne", background="#FFF59D")
            zone_texte.mark_set(tk.INSERT, idx_debut)
            zone_texte.see(idx_debut)
    except:
        pass

def generer_audio_morceau(morceau, selection_langue, params, facteur_vitesse, temp_path):
    if selection_langue.startswith("Local:"):
        nom_voix = selection_langue.replace("Local: ", "").strip().lower()
        chemin_onnx = None
        for f in os.listdir(DOSSIER_VOIX_LANGUES):
            if f.endswith(".onnx") and (nom_voix in f.lower() or f.lower().startswith(nom_voix)):
                chemin_onnx = os.path.join(DOSSIER_VOIX_LANGUES, f)
                break
        
        if chemin_onnx and os.path.exists(chemin_onnx):
            try:
                cmd_piper = ["piper", "--model", chemin_onnx, "--output_file", temp_path]
                res_piper = subprocess.run(cmd_piper, input=morceau.encode('utf-8'), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                
                if res_piper.returncode == 0:
                    if facteur_vitesse != 1.0:
                        temp_vitesse = temp_path + ".spd.mp3"
                        cmd_v = ["ffmpeg", "-y", "-i", temp_path, "-filter:a", f"atempo={facteur_vitesse}", temp_vitesse]
                        subprocess.run(cmd_v, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        if os.path.exists(temp_vitesse):
                            os.replace(temp_vitesse, temp_path)
                    return True
                else:
                    erreur_msg = res_piper.stderr.decode('utf-8', errors='ignore')
                    raise Exception(f"Erreur d'exécution Piper TTS :\n{erreur_msg}")
            except FileNotFoundError:
                raise Exception("L'exécutable 'piper' est introuvable sur votre système Ubuntu.\nVeuillez installer Piper pour utiliser les voix .onnx.")
        else:
            raise Exception(f"Le fichier modèle .onnx correspondant à '{selection_langue}' est introuvable dans le dossier :\n{DOSSIER_VOIX_LANGUES}")

    if facteur_vitesse == 1.0:
        tts = gTTS(text=morceau, lang=params["lang"], tld=params["tld"], slow=False)
        tts.save(temp_path)
    else:
        with tempfile.NamedTemporaryFile(delete=False, suffix=".mp3") as temp_raw:
            temp_raw_path = temp_raw.name
            fichiers_temporaires.append(temp_raw_path)
        
        tts = gTTS(text=morceau, lang=params["lang"], tld=params["tld"], slow=False)
        tts.save(temp_raw_path)

        cmd = [
            "ffmpeg", "-y", "-i", temp_raw_path,
            "-filter:a", f"atempo={facteur_vitesse}",
            "-b:a", "192k",
            temp_path
        ]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True

def executer_conversion(fichier_mp3):
    global conversion_en_cours, fichiers_temporaires
    fichiers_parties = []
    try:
        texte = zone_texte.get("1.0", tk.END).strip()
        selection_langue = combo_langue.get()
        dico_langues = {
            "Français (France)": {"lang": "fr", "tld": "com"},
            "Français (Canada)": {"lang": "fr", "tld": "ca"},
            "Anglais (États-Unis)": {"lang": "en", "tld": "com"},
            "Anglais (Royaume-Uni)": {"lang": "en", "tld": "co.uk"},
            "Espagnol": {"lang": "es", "tld": "com"},
            "Italien": {"lang": "it", "tld": "com"}
        }
        params = dico_langues.get(selection_langue, {"lang": "fr", "tld": "com"})
        
        selection_vitesse = combo_vitesse.get()
        dico_vitesses = {
            "0.5x (Très lent)": 0.5, "0.75x (Ralenti)": 0.75, "0.9x (Léger ralenti)": 0.9,
            "0.95x (Ralenti fin)": 0.95, "1.0x (Standard)": 1.0, "1.25x (Rapide)": 1.25, 
            "1.5x (Très rapide)": 1.5, "1.75x (Soutenu)": 1.75, "2.0x (Double vitesse)": 2.0
        }
        facteur_vitesse = dico_vitesses.get(selection_vitesse, 1.0)

        morceaux = re.split(r'(?<=[.!?\n])\s+', texte)
        morceaux = [m.strip() for m in morceaux if m.strip()]

        if not morceaux:
            restaurer_bouton_conversion()
            return

        for morceau in morceaux:
            if not conversion_en_cours:
                break

            root.after(0, lambda m=morceau: surligner_morceau(m))

            with tempfile.NamedTemporaryFile(delete=False, suffix=".mp3") as temp_file:
                temp_path = temp_file.name
                fichiers_temporaires.append(temp_path)
                fichiers_parties.append(temp_path)

            generer_audio_morceau(morceau, selection_langue, params, facteur_vitesse, temp_path)

        if not conversion_en_cours:
            restaurer_bouton_conversion()
            return

        list_path = tempfile.NamedTemporaryFile(delete=False, mode='w', suffix='.txt', encoding='utf-8')
        for f_path in fichiers_parties:
            list_path.write(f"file '{f_path}'\n")
        list_path.close()
        fichiers_temporaires.append(list_path.name)

        cmd_concat = [
            "ffmpeg", "-y", "-f", "concat", "-safe", "0",
            "-i", list_path.name, "-b:a", "192k", fichier_mp3
        ]
        res = subprocess.run(cmd_concat, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

        if res.returncode != 0:
            raise Exception("Erreur lors de l'assemblage final du fichier MP3 avec ffmpeg.")

        root.after(0, lambda: messagebox.showinfo("Succès", f"Fichier audio généré avec succès :\n{fichier_mp3}"))
        
    except Exception as e:
        root.after(0, lambda err=str(e): messagebox.showwarning("Avertissement - Voix Locale", err))
    
    finally:
        conversion_en_cours = False
        restaurer_bouton_conversion()

def restaurer_bouton_conversion():
    def _restaurer():
        zone_texte.tag_remove("surligne", "1.0", tk.END)
        btn_convertir_actif.set(True)
        lbl_convertir.config(text="Convertir en MP3", bg="#4CAF50", fg="white", cursor="hand2")
    root.after(0, _restaurer)

def lancer_conversion_thread(event=None):
    global conversion_en_cours
    if not btn_convertir_actif.get() or conversion_en_cours:
        return
    
    texte = zone_texte.get("1.0", tk.END).strip()
    if not texte:
        messagebox.showwarning("Attention", "La zone de texte est vide.")
        return

    dernier_dir = config_actuelle.get("dernier_dossier", os.path.expanduser("~"))
    fichier_mp3 = filedialog.asksaveasfilename(
        initialdir=dernier_dir,
        defaultextension=".mp3",
        filetypes=[("Fichiers MP3", "*.mp3")],
        title="Enregistrer le fichier audio sous"
    )
    
    if not fichier_mp3:
        return

    conversion_en_cours = True
    btn_convertir_actif.set(False)
    lbl_convertir.config(bg="#D32F2F", fg="white", cursor="arrow")
    lbl_convertir.config(text="Conversion en cours...")
    
    threading.Thread(target=executer_conversion, args=(fichier_mp3,), daemon=True).start()

