            return
    try:
        with open(chemin, 'r', encoding='utf-8') as f:
            contenu = f.read()
        chemin_fichier_actuel = chemin
        entree_chemin.delete(0, tk.END)
        entree_chemin.insert(0, chemin)
        zone_texte.delete("1.0", tk.END)
        zone_texte.insert("1.0", contenu)
